# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored. Never commit real credentials.

# Required for notes, flashcards, quizzes, and Ask AI answers.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=replace_with_your_key

# Optional: Gemini model used for generation, and the model tried if it is
# rate-limited, overloaded, or times out. Set the fallback empty to disable it.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Optional: Sentence Transformers model for Ask AI. Changing it re-indexes lectures.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: where ChromaDB stores vectors. Defaults to backend/data/chroma.
# CHROMA_PATH=./data/chroma
